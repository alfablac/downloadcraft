{
  "manifest_version": 2,
  "name": "idmcraft Integration Module",
  "version": "0.1.0",
  "description": "Send downloads to idmcraft desktop app",
  "browser_specific_settings": { "gecko": { "id": "idmcraft@idmcraft.local", "strict_min_version": "109.0" } },
  "background": { "scripts": ["background.js"], "persistent": false },
  "permissions": ["contextMenus", "downloads", "cookies", "tabs", "nativeMessaging", "webRequest", "<all_urls>", "storage"],
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true }],
  "browser_action": { "default_title": "idmcraft" }
}
