{
  "manifest_version": 3,
  "name": "idmcraft Integration Module",
  "version": "0.1.0",
  "description": "Send downloads to idmcraft desktop app",
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "downloads", "cookies", "tabs", "nativeMessaging", "webRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true }],
  "action": { "default_title": "idmcraft" }
}
